{
  "name": "dsh-windows-control",
  "version": "0.2.3",
  "description": "Windows desktop automation for DeepSeek Harness — mounts CursorTouch/Windows-MCP through the official MCP client bridge, plus a native Win32 fast path for window geometry, launching and input.",
  "license": "MIT",
  "author": "dsh-windows-control contributors",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "windows",
    "windows-mcp",
    "automation",
    "computer-use",
    "ui-automation",
    "screenshot",
    "win32",
    "fastpath"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "check": "node --check lib/index.js",
    "dump": "node scripts/dump-config.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xkzm123/dsh-windows-control.git"
  },
  "bugs": {
    "url": "https://github.com/xkzm123/dsh-windows-control/issues"
  },
  "homepage": "https://github.com/xkzm123/dsh-windows-control#readme",
  "devDependencies": {
    "js-yaml": "^4.1.0"
  },
  "contributors": [
    {
      "name": "helloHub1212",
      "url": "https://github.com/helloHub1212"
    }
  ]
}
